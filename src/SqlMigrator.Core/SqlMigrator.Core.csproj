<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlMigrator.Model\SqlMigrator.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Identifier quoting is an implementation detail, but it is the only barrier
         between a caller-supplied table name and the command text, so it is tested
         directly rather than only through a live database round-trip. -->
    <InternalsVisibleTo Include="SqlMigrator.Core.Tests" />
  </ItemGroup>

</Project>
